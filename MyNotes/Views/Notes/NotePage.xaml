<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Notes.NotePage"
      x:Name="NotePage_RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="using:System"
      xmlns:helpers="using:MyNotes.Common.Helpers"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:ctwc="using:CommunityToolkit.WinUI.Controls"
      xmlns:mxi="using:Microsoft.Xaml.Interactivity"
      xmlns:muxm="using:Microsoft.UI.Xaml.Media"
      xmlns:manm="using:MyNotes.Application.Contracts.Notes.Models"
      RequestedTheme="{x:Bind helpers:ColorHelper.GetThemeFromColor(Note.BackgroundColor), Mode=OneWay}">

  <Page.Resources>
    <Style x:Key="DefaultThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Default" />
    </Style>
    <Style x:Key="LightThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Light" />
    </Style>
    <Style x:Key="DarkThemeFlyoutPresenterStyle"
           TargetType="FlyoutPresenter"
           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Dark" />
    </Style>
    <Style x:Key="DefaultThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Default" />
    </Style>
    <Style x:Key="LightThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Light" />
    </Style>
    <Style x:Key="DarkThemeMenuFlyoutPresenterStyle"
           TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
      <Setter Property="RequestedTheme"
              Value="Dark" />
      <Setter Property="Background"
              Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

    </Style>

    <PathIconSource x:Key="ImageMultipleOffPathIconSource"
                    Data="M12.309,13.016L14.146,14.854A0.5,0.5,0,0,0,14.854,14.146L1.854,1.146A0.5,0.5,0,1,0,1.146,1.854L2.414,3.12A2.5,2.5,0,0,0,2,4.5L2,9.5A2.5,2.5,0,0,0,4.5,12L9.5,12C10.01,12,10.483,11.848,10.879,11.586L11.596,12.303A3.5,3.5,0,0,1,9.5,13L5,13C5.456,13.607,6.182,14,7,14L9.5,14A4.48,4.48,0,0,0,12.309,13.016 M10.147,10.854A1.5,1.5,0,0,1,9.5,11L4.5,11C4.268,11,4.05,10.947,3.853,10.854L6.498,8.209A0.71,0.71,0,0,1,7.499,8.206L7.502,8.209z M6.402,7.109A1.7,1.7,0,0,0,5.791,7.502L3.146,10.147A1.5,1.5,0,0,1,3,9.5L3,4.5C3,4.268,3.052,4.05,3.146,3.853z M11,4.5L11,8.879 11.975,9.854Q12,9.68,12,9.5L12,4.5A2.5,2.5,0,0,0,9.5,2L4.5,2Q4.32,2,4.146,2.025L5.121,3 9.5,3A1.5,1.5,0,0,1,11,4.5 M12.797,10.676L13.561,11.44A4.5,4.5,0,0,0,14,9.5L14,6C14,5.182,13.607,4.456,13,4L13,9.5C13,9.913,12.928,10.309,12.797,10.676 M10,5A1,1,0,1,1,8,5A1,1,0,0,1,10,5" />
  </Page.Resources>
  <Grid Background="{x:Bind helpers:ColorHelper.GetBackgroundBrushForBackdrop(Note.BackdropKind, Note.BackgroundColor), Mode=OneWay}"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator x:Name="NotePage_SaveKeyboardAccelerator"
                           Modifiers="Control"
                           Key="S"
                           Invoked="NotePage_SaveKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_FindKeyboardAccelerator"
                           Modifiers="Control"
                           Key="F"
                           Invoked="NotePage_FindKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_ReplaceKeyboardAccelerator"
                           Modifiers="Control"
                           Key="H"
                           Invoked="NotePage_ReplaceKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator x:Name="NotePage_RenameTitleKeyboardAccelerator"
                           Key="F2"
                           Invoked="NotePage_RenameTitleKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator Modifiers="Control"
                           Key="N">
        <mxi:Interaction.Behaviors>
          <mxi:EventTriggerBehavior EventName="Invoked">
            <mxi:InvokeCommandAction Command="{x:Bind NoteViewModel.CreateNewNoteCommand}" />
          </mxi:EventTriggerBehavior>
        </mxi:Interaction.Behaviors>
      </KeyboardAccelerator>
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--#region Background Image -->
    <Grid Grid.Row="0"
          Grid.RowSpan="4"
          Visibility="{x:Bind Note.ShowBackgroundImage, Mode=OneWay}">
      <Rectangle>
        <Rectangle.Fill>
          <ImageBrush ImageSource="{x:Bind NoteViewModel.BackgroundImage, Mode=OneWay}"
                      Stretch="{x:Bind Note.BackgroundImageStretch, Mode=OneWay}"
                      Opacity="{x:Bind Note.BackgroundImageOpacity, Mode=OneWay}"
                      AlignmentX="{x:Bind EditorViewModel.BackgroundImageAlignmentX, Mode=OneWay}"
                      AlignmentY="{x:Bind EditorViewModel.BackgroundImageAlignmentY, Mode=OneWay}" />
        </Rectangle.Fill>
      </Rectangle>

      <Border xmlns:ctwm="using:CommunityToolkit.WinUI.Media">
        <Border.Background>
          <ctwm:BackdropBlurBrush Amount="{x:Bind Note.BackgroundImageBlur, Mode=OneWay}" />
        </Border.Background>
      </Border>
    </Grid>
    <!--#endregion -->

    <!--#region Title Bar -->
    <Grid x:Name="NotePage_TitleBarGrid"
          Grid.Row="0"
          Height="40"
          Loaded="NotePage_TitleBarGrid_Loaded"
          SizeChanged="NotePage_TitleBarGrid_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PinButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="MoreButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="TitleColumn" />
        <ColumnDefinition x:Name="MinimizeButtonColumn"
                          Width="Auto" />
        <ColumnDefinition x:Name="CloseButtonColumn"
                          Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Pin Button -->
      <templates:AlternateSubtleIconToggleButton x:Name="NotePage_PinButton"
                                                 x:Uid="/NotePage/PinButton"
                                                 Grid.Column="0"
                                                 IsChecked="{x:Bind Note.IsAlwaysOnTop, Mode=TwoWay}"
                                                 Command="{x:Bind NoteViewModel.PinWindowCommand}">
        <templates:AlternateSubtleIconToggleButton.Icon>
          <FontIcon Glyph="&#xE718;" />
        </templates:AlternateSubtleIconToggleButton.Icon>
        <templates:AlternateSubtleIconToggleButton.CheckedIcon>
          <Grid>
            <FontIcon Glyph="&#xE841;" />
            <FontIcon Glyph="&#xE718;" />
          </Grid>
        </templates:AlternateSubtleIconToggleButton.CheckedIcon>
        <templates:AlternateSubtleIconToggleButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_PinButton_TranslateTransform" />
        </templates:AlternateSubtleIconToggleButton.RenderTransform>
        <templates:AlternateSubtleIconToggleButton.KeyboardAccelerators>
          <KeyboardAccelerator Modifiers="Control"
                               Key="P" />
        </templates:AlternateSubtleIconToggleButton.KeyboardAccelerators>
      </templates:AlternateSubtleIconToggleButton>

      <!--#region More Button -->
      <templates:SubtleIconButton x:Name="NotePage_MoreButton"
                                  x:Uid="/NotePage/MoreButton"
                                  Grid.Column="1"
                                  Content="{ctw:FontIcon Glyph=&#xE712;}">
        <templates:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_MoreButton_TranslateTransform" />
        </templates:SubtleIconButton.RenderTransform>
        <templates:SubtleIconButton.Flyout>
          <MenuFlyout x:Name="NotePage_MoreButtonMenuFlyout"
                      Placement="RightEdgeAlignedTop"
                      ShouldConstrainToRootBounds="False"
                      MenuFlyoutPresenterStyle="{StaticResource DefaultThemeMenuFlyoutPresenterStyle}">
            <!-- Rename Title -->
            <MenuFlyoutItem x:Name="NotePage_RenameTitleMenuFlyoutItem"
                            x:Uid="/NotePage/RenameTitleMenuFlyoutItem"
                            Icon="Rename"
                            Click="NotePage_RenameTitleMenuFlyoutItem_Click">
              <MenuFlyoutItem.KeyboardAccelerators>
                <KeyboardAccelerator Key="F2" />
              </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <!-- New Note -->
            <MenuFlyoutItem x:Uid="/NotePage/NewNoteMenuFlyoutItem"
                            Icon="Add"
                            Command="{x:Bind NoteViewModel.CreateNewNoteCommand}">
              <MenuFlyoutItem.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control"
                                     Key="N" />
              </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- View List -->
            <MenuFlyoutItem x:Uid="/NotePage/ViewListMenuFlyoutItem"
                            Icon="{ctw:FontIcon Glyph=&#xE71D;}"
                            Command="{x:Bind NoteViewModel.ViewListCommand}" />

            <MenuFlyoutSeparator />

            <!-- Bookmark and Unbookmark -->
            <templates:AlternateMenuFlyoutItem x:Uid="/NotePage/BookmarkMenuFlyoutItem"
                                               Icon="Favorite"
                                               CheckedIcon="UnFavorite"
                                               IsChecked="{x:Bind Note.IsBookmarked, Mode=OneWay}"
                                               Command="{x:Bind NoteViewModel.ToggleBookmarkNoteCommand}" />

            <!-- Show Images -->
            <templates:AlternateMenuFlyoutItem x:Uid="/NotePage/ShowImagesMenuFlyoutItem"
                                               Icon="{ctw:FontIcon Glyph=&#xE8B9;}"
                                               IsChecked="{x:Bind Note.ShowImagePanel, Mode=TwoWay}"
                                               Visibility="{x:Bind ImageCollectionViewModel.HasImages, Mode=OneWay}">
              <templates:AlternateMenuFlyoutItem.CheckedIcon>
                <IconSourceElement IconSource="{StaticResource ImageMultipleOffPathIconSource}" />
              </templates:AlternateMenuFlyoutItem.CheckedIcon>
            </templates:AlternateMenuFlyoutItem>

            <!-- View Mode -->
            <templates:AlternateMenuFlyoutItem x:Uid="/NotePage/ViewModeFlyoutSubItem"
                                               Icon="View"
                                               CheckedIcon="Edit"
                                               IsChecked="{x:Bind Note.IsTextEditorReadOnly, Mode=TwoWay}" />

            <MenuFlyoutSeparator />

            <!-- Save As -->
            <MenuFlyoutSubItem x:Uid="/NotePage/SaveAsMenuFlyoutSubItem"
                               Icon="Save">
              <MenuFlyoutItem x:Uid="/NotePage/SaveAsPlainTextMenuFlyoutItem"
                              Tag="SaveAsPlainText"
                              Click="NotePage_SaveAsMenuFlyoutItem_Click" />
              <MenuFlyoutItem x:Uid="/NotePage/SaveAsRichTextMenuFlyoutItem"
                              Tag="SaveAsRichText"
                              Click="NotePage_SaveAsMenuFlyoutItem_Click" />
              <!--<MenuFlyoutItem Text="PDF (*.pdf)"
                              Tag="SaveAsPDF" />-->
            </MenuFlyoutSubItem>

            <!-- Share -->
            <MenuFlyoutItem x:Uid="/NotePage/ShareMenuFlyoutItem"
                            Icon="Share" />

            <MenuFlyoutSeparator />

            <!-- Delete Note -->
            <MenuFlyoutItem x:Uid="/NotePage/DeleteMenuFlyoutItem"
                            Icon="Delete"
                            Style="{StaticResource EmphasisCriticalMenuFlyoutItemStyle}" />
          </MenuFlyout>
        </templates:SubtleIconButton.Flyout>
      </templates:SubtleIconButton>
      <!--#endregion -->

      <!--#region Title -->
      <TextBlock x:Name="NotePage_TitleTextBlock"
                 Grid.Column="2"
                 Text="{x:Bind Note.Title, Mode=OneWay}"
                 Margin="4,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 Style="{StaticResource BodyStrongTextBlockStyle}" />

      <TextBox x:Name="NotePage_TitleRenameTextBox"
               Grid.Column="2"
               Text="{x:Bind Note.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
               MinWidth="200"
               Visibility="Collapsed"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               LostFocus="NotePage_TitleRenameTextBox_LostFocus">
        <mxi:Interaction.Behaviors>
          <mxi:EventTriggerBehavior EventName="LostFocus">
            <mxi:InvokeCommandAction Command="{x:Bind NoteViewModel.RenameNoteTitleCommand}" />
          </mxi:EventTriggerBehavior>
        </mxi:Interaction.Behaviors>
      </TextBox>
      <!--#endregion -->

      <!--#region Caption Buttons -->
      <templates:SubtleIconButton x:Name="NotePage_MinimizeButton"
                                  x:Uid="/NotePage/MinimizeButton"
                                  Grid.Column="3"
                                  Content="{ctw:FontIcon Glyph=&#xE738;}"
                                  Command="{x:Bind NoteViewModel.MinimizeWindowCommand}">
        <templates:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_MinimizeButton_TranslateTransform" />
        </templates:SubtleIconButton.RenderTransform>
      </templates:SubtleIconButton>
      <templates:SubtleIconButton x:Name="NotePage_CloseButton"
                                  x:Uid="/NotePage/CloseButton"
                                  Grid.Column="4"
                                  Content="{ctw:FontIcon Glyph=&#xE711;}"
                                  Command="{x:Bind NoteViewModel.CloseWindowCommand}">
        <templates:SubtleIconButton.RenderTransform>
          <TranslateTransform x:Name="NotePage_CloseButton_TranslateTransform" />
        </templates:SubtleIconButton.RenderTransform>
      </templates:SubtleIconButton>
      <!--#endregion -->
    </Grid>
    <!--#endregion -->

    <!--#region Images -->
    <Grid x:Name="NotePage_ImagePanelGrid"
          Grid.Row="1"
          Visibility="{x:Bind helpers:BooleanHelper.VisibleWhenAll(ImageCollectionViewModel.HasImages, Note.ShowImagePanel), Mode=OneWay}"
          Padding="6,0">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="12" />
      </Grid.RowDefinitions>
      <GridView x:Name="NotePage_ImagesGridView"
                x:Load="{x:Bind helpers:BooleanHelper.And(ImageCollectionViewModel.HasImages, Note.ShowImagePanel), Mode=OneWay}"
                Grid.Row="0"
                CanDragItems="True"
                AllowDrop="True"
                ItemsSource="{x:Bind ImageCollectionViewModel.ImageViewModels}"
                SelectionMode="None"
                AllowFocusOnInteraction="False"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                Height="{x:Bind Note.ImagePanelHeight, Mode=TwoWay}"
                MinHeight="120"
                MaxHeight="{x:Bind NoteViewModel.ImagePanelMaxHeight, Mode=OneWay}"
                Padding="0,0,0,6"
                DragItemsStarting="NotePage_ImagesGridView_DragItemsStarting"
                DragOver="NotePage_ImagesGridView_DragOver"
                Drop="NotePage_ImagesGridView_Drop">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>

        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem"
                 BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="AllowDrop"
                    Value="True" />
          </Style>
        </GridView.ItemContainerStyle>

        <GridView.ItemTemplate>
          <DataTemplate x:DataType="mvmm:ImageViewModel"
                        xmlns:mvmm="using:MyNotes.ViewModels.Media"
                        xmlns:mvm="using:MyNotes.Views.Media">
            <mvm:ImageThumbnailItemContainer ViewModel="{x:Bind}"
                                             DecodePixelHeight="512" />
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <ctwc:ContentSizer x:Name="NotePage_ImagePanelContentSizer"
                         TargetControl="{x:Bind NotePage_ImagesGridView}"
                         Grid.Row="1"
                         Orientation="Horizontal"
                         Cursor="Arrow" />
    </Grid>
    <!--#endregion -->

    <!--#region Text Editor -->
    <Border Grid.Row="2">
      <RichEditBox x:Name="NotePage_TextEditorRichEditBox"
                   RequestedTheme="Light"
                   SelectionFlyout="{x:Null}"
                   SelectionHighlightColorWhenNotFocused="{StaticResource AccentFillColorSelectedTextBackgroundBrush}"
                   MaxLength="100000"
                   IsSpellCheckEnabled="False"
                   TextWrapping="Wrap"
                   Paste="NotePage_TextEditorRichEditBox_Paste"
                   IsReadOnly="{x:Bind Note.IsTextEditorReadOnly, Mode=OneWay}">
        <RichEditBox.Resources>
          <SolidColorBrush x:Key="TextControlBorderBrush"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackground"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused"
                           Color="{StaticResource ControlFillColorTransparent}" />
        </RichEditBox.Resources>

        <mxi:Interaction.Behaviors>
          <mxi:EventTriggerBehavior EventName="SelectionChanged">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateSelectionCommand}" />
          </mxi:EventTriggerBehavior>
          <mxi:EventTriggerBehavior EventName="TextChanging">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateTextChangingCommand}" />
          </mxi:EventTriggerBehavior>
          <mxi:EventTriggerBehavior EventName="TextChanged">
            <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.UpdateTextChangedCommand}" />
          </mxi:EventTriggerBehavior>
        </mxi:Interaction.Behaviors>
      </RichEditBox>
    </Border>
    <!--#endregion -->

    <!--#region Find and Replace -->
    <templates:FindReplaceBox x:Name="NotePage_FindReplaceBox"
                              Grid.Row="1"
                              Grid.RowSpan="2"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right"
                              TargetEditor="{x:Bind NotePage_TextEditorRichEditBox}"
                              IsOpen="False"
                              RequestedTheme="{x:Bind NotePage_RootPage.RequestedTheme, Mode=OneTime}"
                              Margin="12" />
    <!--#endregion -->

    <!--#region Command Bar -->
    <ScrollViewer x:Name="NotePage_CommandBarScrollViewer"
                  Grid.Row="3"
                  HorizontalScrollMode="Enabled"
                  VerticalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">

      <ScrollViewer.RenderTransform>
        <TranslateTransform x:Name="NotePage_CommandBarScrollViewer_TranslateTransform" />
      </ScrollViewer.RenderTransform>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="3"
                  Padding="3">
        <StackPanel x:Name="NotePage_CommandBarEditPanel"
                    Orientation="Horizontal"
                    Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(Note.IsTextEditorReadOnly), Mode=OneWay}"
                    Spacing="3">
          <!-- Bold -->
          <templates:SubtleIconToggleButton x:Name="NotePage_BoldButton"
                                            x:Uid="/NotePage/BoldButton"
                                            Content="{ctw:FontIcon Glyph=&#xE8DD;}"
                                            AllowFocusOnInteraction="False"
                                            IsChecked="{x:Bind EditorViewModel.IsSelectionBold, Mode=TwoWay}" />

          <!-- Italic -->
          <templates:SubtleIconToggleButton x:Name="NotePage_ItalicButton"
                                            x:Uid="/NotePage/ItalicButton"
                                            Content="{ctw:FontIcon Glyph=&#xE8DB;}"
                                            AllowFocusOnInteraction="False"
                                            IsChecked="{x:Bind EditorViewModel.IsSelectionItalic, Mode=TwoWay}" />

          <!-- Underline -->
          <templates:SubtleIconToggleButton x:Name="NotePage_UnderlineButton"
                                            x:Uid="/NotePage/UnderlineButton"
                                            Content="{ctw:FontIcon Glyph=&#xE8DC;}"
                                            AllowFocusOnInteraction="False"
                                            IsChecked="{x:Bind EditorViewModel.IsSelectionUnderlined, Mode=TwoWay}" />

          <!-- Strikethrough -->
          <templates:SubtleIconToggleButton x:Name="NotePage_StrikethroughButton"
                                            x:Uid="/NotePage/StrikethroughButton"
                                            Content="{ctw:FontIcon Glyph=&#xEDE0;}"
                                            AllowFocusOnInteraction="False"
                                            IsChecked="{x:Bind EditorViewModel.IsSelectionStrikethrough, Mode=TwoWay}">
            <templates:SubtleIconToggleButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                                   Key="T" />
            </templates:SubtleIconToggleButton.KeyboardAccelerators>
          </templates:SubtleIconToggleButton>

          <!-- Bullets and Numbering -->
          <templates:SubtleIconToggleSplitButton x:Name="NotePage_BulletsAndNumberingButton"
                                                 x:Uid="/NotePage/BulletsAndNumberingButton"
                                                 Content="{ctw:FontIcon Glyph=&#xE8BC;}"
                                                 AllowFocusOnInteraction="False"
                                                 IsChecked="{x:Bind EditorViewModel.IsSelectionParagraphList, Mode=TwoWay}">

            <templates:SubtleIconToggleSplitButton.Flyout>
              <Flyout x:Name="NotePage_BulletsAndNumberingButtonFlyout"
                      Placement="Top"
                      ShouldConstrainToRootBounds="False"
                      FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">
                <StackPanel Spacing="12">
                  <TextBlock x:Uid="/NotePage/MarkerTypeTextBlock"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <GridView ItemsSource="{x:Bind EditorViewModel.MarkerTypeMap.Rights}"
                            SelectedItem="{x:Bind EditorViewModel.SelectedMarkerType, Mode=TwoWay}"
                            Padding="0">
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="5" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Width="40"
                                Height="40">
                          <TextBlock Text="{x:Bind}"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Padding="0,0,0,6"
                                     FontWeight="Light"
                                     FontSize="20" />
                        </Border>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>

                  <NavigationViewItemSeparator />

                  <TextBlock x:Uid="/NotePage/MarkerStyleTextBlock"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <GridView ItemsSource="{x:Bind EditorViewModel.MarkerStyleMap.Rights}"
                            SelectedItem="{x:Bind EditorViewModel.SelectedMarkerStyle, Mode=TwoWay}"
                            IsEnabled="{x:Bind EditorViewModel.IsSelectionMarkerStyleEnabled, Mode=OneWay}"
                            Padding="0">
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="5" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <templates:TextContentControl Width="40"
                                                      Height="40"
                                                      Text="{x:Bind}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Padding="0,0,0,6"
                                                      FontWeight="Light"
                                                      FontSize="20" />
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                </StackPanel>
              </Flyout>
            </templates:SubtleIconToggleSplitButton.Flyout>
          </templates:SubtleIconToggleSplitButton>

          <Rectangle Width="1"
                     Stretch="Fill"
                     Margin="0,6"
                     Fill="{ThemeResource DividerStrokeColorDefault}" />

          <!-- Font Size -->
          <templates:SubtleIconButton x:Name="NotePage_FontSizeButton"
                                      x:Uid="/NotePage/FontSizeButton"
                                      Content="{ctw:FontIcon Glyph=&#xE8E9;}">
            <templates:SubtleIconButton.Flyout>
              <Flyout x:Name="NotePage_FontSizeButtonFlyout"
                      Placement="Top"
                      ShouldConstrainToRootBounds="False"
                      FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">
                <StackPanel Spacing="12">
                  <TextBlock x:Uid="/NotePage/FontSizeFlyoutHeaderTextBlock"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />

                  <StackPanel Orientation="Horizontal"
                              Spacing="6">
                    <RepeatButton x:Name="NotePage_DecreaseFontSizeButton"
                                  x:Uid="/NotePage/DecreaseFontSizeButton"
                                  Content="{ctw:FontIcon Glyph=&#xE949;}"
                                  Style="{StaticResource SubtleIconRepeatButtonStyle}"
                                  Command="{x:Bind EditorViewModel.DecreaseSelectionFontSizeCommand}" />
                    <ComboBox x:Name="NotePage_FontSizeComboBox"
                              Width="90"
                              VerticalAlignment="Center"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              ItemsSource="{x:Bind EditorViewModel.FontSizes}"
                              SelectedItem="{x:Bind EditorViewModel.SelectionFontSizeText, Mode=TwoWay}"
                              Text="{x:Bind EditorViewModel.SelectionFontSizeText, Mode=OneWay}" />
                    <RepeatButton x:Name="NotePage_IncreaseFontSizeButton"
                                  x:Uid="/NotePage/IncreaseFontSizeButton"
                                  Content="{ctw:FontIcon Glyph=&#xE948;}"
                                  Style="{StaticResource SubtleIconRepeatButtonStyle}"
                                  Command="{x:Bind EditorViewModel.IncreaseSelectionFontSizeCommand}" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </templates:SubtleIconButton.Flyout>
          </templates:SubtleIconButton>

          <!-- Font Color -->
          <templates:SubtleIconSplitButton x:Name="NotePage_FontColorButton"
                                           x:Uid="/NotePage/FontColorButton">
            <templates:SubtleIconSplitButton.Content>
              <Grid>
                <Border CornerRadius="3"
                        RenderTransformOrigin="0.5, 0.95">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.8"
                                    ScaleY="0.3" />
                  </Border.RenderTransform>
                  <Border Background="{x:Bind helpers:ColorHelper.ToBrush(EditorViewModel.RecentFontColor), Mode=OneWay}" />
                </Border>
                <FontIcon Glyph="&#xE8D3;" />

              </Grid>
            </templates:SubtleIconSplitButton.Content>

            <mxi:Interaction.Behaviors>
              <mxi:EventTriggerBehavior EventName="Click">
                <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.ChangeSelectionFontColorCommand}" />
              </mxi:EventTriggerBehavior>
            </mxi:Interaction.Behaviors>

            <templates:SubtleIconSplitButton.SecondaryFlyout>
              <Flyout x:Name="NotePage_FontColorButtonFlyout"
                      Placement="Top"
                      ShouldConstrainToRootBounds="False"
                      FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">
                <StackPanel Spacing="12"
                            Width="340">
                  <TextBlock x:Uid="/NotePage/FontColorFlyoutHeaderTextBlock"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <ctwc:Segmented x:Name="NotePage_FontColorSegmented"
                                  HorizontalAlignment="Center"
                                  SelectedIndex="0">
                    <ctwc:SegmentedItem x:Uid="/NotePage/ColorPaletteSegmentedItem"
                                        Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                        Width="160" />
                    <ctwc:SegmentedItem x:Uid="/NotePage/ColorPickerSegmentedItem"
                                        Icon="{ctw:FontIcon Glyph=&#xEF3C;}"
                                        Width="160" />
                  </ctwc:Segmented>
                  <ctwc:SwitchPresenter Value="{x:Bind NotePage_FontColorSegmented.SelectedIndex, Mode=OneWay}">
                    <ctwc:Case>
                      <ctwc:Case.Value>
                        <x:Int32>0</x:Int32>
                      </ctwc:Case.Value>
                      <Grid MaxHeight="363"
                            HorizontalAlignment="Center">
                        <GridView x:Name="NotePage_FontColorPaletteGridView"
                                  ItemsSource="{x:Bind EditorViewModel.PaletteFontColors}"
                                  SelectedItem="{x:Bind EditorViewModel.SelectedPaletteFontColor, Mode=TwoWay}"
                                  Padding="12,0">
                          <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                              <ItemsWrapGrid Orientation="Horizontal"
                                             MaximumRowsOrColumns="6" />
                            </ItemsPanelTemplate>
                          </GridView.ItemsPanel>
                          <GridView.ItemTemplate>
                            <DataTemplate x:DataType="SolidColorBrush">
                              <Border Width="48"
                                      Height="48"
                                      Background="{x:Bind}"
                                      CornerRadius="4"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                            </DataTemplate>
                          </GridView.ItemTemplate>
                        </GridView>
                      </Grid>
                    </ctwc:Case>
                    <ctwc:Case>
                      <ctwc:Case.Value>
                        <x:Int32>1</x:Int32>
                      </ctwc:Case.Value>
                      <ColorPicker x:Name="NotePage_FontColorPicker"
                                   Color="{x:Bind EditorViewModel.SelectionFontColor, Mode=TwoWay}"
                                   ColorSpectrumShape="Ring"
                                   IsAlphaEnabled="False"
                                   IsMoreButtonVisible="True" />
                    </ctwc:Case>
                  </ctwc:SwitchPresenter>
                </StackPanel>
              </Flyout>
            </templates:SubtleIconSplitButton.SecondaryFlyout>
          </templates:SubtleIconSplitButton>

          <!-- Text Highlight Color -->
          <templates:SubtleIconSplitButton x:Name="NotePage_TextHighlightColorButton"
                                           x:Uid="/NotePage/TextHighlightColorButton">
            <templates:SubtleIconSplitButton.Content>
              <Grid>
                <FontIcon Glyph="&#xE891;"
                          Foreground="{x:Bind helpers:ColorHelper.ToBrush(EditorViewModel.RecentHighlightColor), Mode=OneWay}" />
                <FontIcon Glyph="&#xE7E6;" />

              </Grid>
            </templates:SubtleIconSplitButton.Content>

            <mxi:Interaction.Behaviors>
              <mxi:EventTriggerBehavior EventName="Click">
                <mxi:InvokeCommandAction Command="{x:Bind EditorViewModel.ChangeSelectionHighlightColorCommand}" />
              </mxi:EventTriggerBehavior>
            </mxi:Interaction.Behaviors>

            <templates:SubtleIconSplitButton.SecondaryFlyout>
              <Flyout x:Name="NotePage_HighlightColorButtonFlyout"
                      Placement="Top"
                      ShouldConstrainToRootBounds="False"
                      FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">
                <StackPanel Spacing="12"
                            Width="340">
                  <TextBlock x:Uid="/NotePage/TextHighlightColorFlyoutHeaderTextBlock"
                             Style="{StaticResource BodyStrongTextBlockStyle}" />

                  <Button x:Uid="/NotePage/TextHighlightColorAutomaticButton"
                          HorizontalAlignment="Stretch"
                          Margin="8,0"
                          Command="{x:Bind EditorViewModel.ChangeSelectionHighlightColorToAutomaticCommand}">
                    <Button.Resources>
                      <SolidColorBrush x:Key="ButtonBackgroundDisabled"
                                       Color="{ThemeResource ControlAltFillColorQuarternary}" />
                      <SolidColorBrush x:Key="ButtonForegroundDisabled"
                                       Color="{ThemeResource TextFillColorPrimary}" />
                      <SolidColorBrush x:Key="ButtonBorderBrushDisabled"
                                       Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                    </Button.Resources>
                  </Button>
                  <ctwc:Segmented x:Name="NotePage_TextHighlightColorSegmented"
                                  HorizontalAlignment="Center"
                                  SelectedIndex="0">
                    <ctwc:SegmentedItem x:Uid="/NotePage/ColorPaletteSegmentedItem"
                                        Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                        Width="160" />
                    <ctwc:SegmentedItem x:Uid="/NotePage/ColorPickerSegmentedItem"
                                        Icon="{ctw:FontIcon Glyph=&#xEF3C;}"
                                        Width="160" />
                  </ctwc:Segmented>
                  <ctwc:SwitchPresenter Value="{x:Bind NotePage_TextHighlightColorSegmented.SelectedIndex, Mode=OneWay}">
                    <ctwc:Case>
                      <ctwc:Case.Value>
                        <x:Int32>0</x:Int32>
                      </ctwc:Case.Value>
                      <Grid MaxHeight="363"
                            HorizontalAlignment="Center">
                        <GridView x:Name="NotePage_TextHighlightColorPaletteGridView"
                                  ItemsSource="{x:Bind EditorViewModel.PaletteHighlightColors}"
                                  SelectedItem="{x:Bind EditorViewModel.SelectedPaletteHighlightColor, Mode=TwoWay}"
                                  Padding="12,0">
                          <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                              <ItemsWrapGrid Orientation="Horizontal"
                                             MaximumRowsOrColumns="6" />
                            </ItemsPanelTemplate>
                          </GridView.ItemsPanel>
                          <GridView.ItemTemplate>
                            <DataTemplate x:DataType="SolidColorBrush">
                              <Border Width="48"
                                      Height="48"
                                      Background="{x:Bind}"
                                      CornerRadius="4"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                            </DataTemplate>
                          </GridView.ItemTemplate>
                        </GridView>
                      </Grid>
                    </ctwc:Case>
                    <ctwc:Case>
                      <ctwc:Case.Value>
                        <x:Int32>1</x:Int32>
                      </ctwc:Case.Value>
                      <ColorPicker x:Name="NotePage_TextHighlightColorPicker"
                                   Color="{x:Bind EditorViewModel.SelectionHighlightColor, Mode=TwoWay}"
                                   ColorSpectrumShape="Ring"
                                   MaxValue="99"
                                   IsAlphaEnabled="False"
                                   IsMoreButtonVisible="True" />
                    </ctwc:Case>
                  </ctwc:SwitchPresenter>
                </StackPanel>
              </Flyout>
            </templates:SubtleIconSplitButton.SecondaryFlyout>
            <templates:SubtleIconSplitButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift"
                                   Key="H" />
            </templates:SubtleIconSplitButton.KeyboardAccelerators>
          </templates:SubtleIconSplitButton>
        </StackPanel>

        <templates:SubtleIconButton x:Uid="/NotePage/EnterEditModeButton"
                                    Content="{ctw:FontIcon Glyph=&#xE70F;}"
                                    Visibility="{x:Bind Note.IsTextEditorReadOnly, Mode=OneWay}"
                                    Command="{x:Bind EditorViewModel.EnterEditModeCommand}" />

        <Rectangle Width="1"
                   Stretch="Fill"
                   Margin="0,6"
                   Fill="{ThemeResource DividerStrokeColorDefault}" />

        <!-- Background and Backdrop -->
        <templates:SubtleIconButton x:Name="NotePage_BackgroundButton"
                                    x:Uid="/NotePage/BackgroundButton"
                                    Content="{ctw:FontIcon Glyph=&#xE790;}">
          <templates:SubtleIconButton.Flyout>
            <Flyout x:Name="NotePage_BackgroundButtonFlyout"
                    Placement="Top"
                    ShouldConstrainToRootBounds="False"
                    FlyoutPresenterStyle="{StaticResource DefaultThemeFlyoutPresenterStyle}">

              <StackPanel Width="340"
                          MinHeight="300">
                <TextBlock x:Uid="/NotePage/BackgroundFlyoutHeaderTextBlock"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,12" />
                <ctwc:Segmented x:Name="NotePage_BackgroundButtonFlyoutSegmented"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                  <ctwc:SegmentedItem x:Uid="/NotePage/BackgroundFlyoutColorSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xE790;}"
                                      HorizontalAlignment="Stretch" />
                  <ctwc:SegmentedItem x:Uid="/NotePage/BackgroundFlyoutEffectSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xE794;}"
                                      HorizontalAlignment="Stretch" />
                  <ctwc:SegmentedItem x:Uid="/NotePage/BackgroundFlyoutImageSegmentedItem"
                                      Icon="{ctw:FontIcon Glyph=&#xE91B;}"
                                      HorizontalAlignment="Stretch" />
                </ctwc:Segmented>
                <ctwc:SwitchPresenter Value="{x:Bind NotePage_BackgroundButtonFlyoutSegmented.SelectedIndex, Mode=OneWay}">
                  <!-- Background Color -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>0</x:Int32>
                    </ctwc:Case.Value>
                    <StackPanel Spacing="12">
                      <SelectorBar x:Name="NotePage_BackgroundColorSelectorBar"
                                   HorizontalAlignment="Center"
                                   SelectedItem="{x:Bind NotePage_BackgroundColorPaletteSelectorBarItem}">
                        <SelectorBarItem x:Name="NotePage_BackgroundColorPaletteSelectorBarItem"
                                         x:Uid="/NotePage/BackgroundColorPaletteSelectorBarItem"
                                         Icon="{ctw:FontIcon Glyph=&#xE790;}" />
                        <SelectorBarItem x:Name="NotePage_BackgroundColorPickerSelectorBarItem"
                                         x:Uid="/NotePage/BackgroundColorPickerSelectorBarItem"
                                         Icon="{ctw:FontIcon Glyph=&#xEF3C;}" />
                      </SelectorBar>

                      <ctwc:SwitchPresenter Value="{x:Bind NotePage_BackgroundColorSelectorBar.SelectedItem, Mode=OneWay}">
                        <ctwc:Case Value="{x:Bind NotePage_BackgroundColorPaletteSelectorBarItem}">
                          <Grid MaxHeight="411"
                                HorizontalAlignment="Center">
                            <GridView x:Name="NotePage_BackgroundColorPaletteGridView"
                                      ItemsSource="{x:Bind EditorViewModel.PaletteBackgroundColors}"
                                      SelectedItem="{x:Bind EditorViewModel.SelectedPaletteBackgroundColor, Mode=TwoWay}"
                                      Padding="12,0">
                              <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <ItemsWrapGrid Orientation="Horizontal"
                                                 MaximumRowsOrColumns="6" />
                                </ItemsPanelTemplate>
                              </GridView.ItemsPanel>
                              <GridView.ItemTemplate>
                                <DataTemplate x:DataType="SolidColorBrush">
                                  <Border Width="48"
                                          Height="48"
                                          Background="{x:Bind}"
                                          CornerRadius="4"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefault}" />
                                </DataTemplate>
                              </GridView.ItemTemplate>
                            </GridView>
                          </Grid>
                        </ctwc:Case>
                        <ctwc:Case Value="{x:Bind NotePage_BackgroundColorPickerSelectorBarItem}">
                          <ColorPicker x:Name="NotePage_BackgroundColorPicker"
                                       HorizontalAlignment="Center"
                                       ColorSpectrumShape="Ring"
                                       IsMoreButtonVisible="True"
                                       Color="{x:Bind Note.BackgroundColor, Mode=TwoWay}" />
                        </ctwc:Case>

                      </ctwc:SwitchPresenter>
                    </StackPanel>
                  </ctwc:Case>

                  <!-- Backdrop(Background Effect) -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>1</x:Int32>
                    </ctwc:Case.Value>

                    <StackPanel Spacing="12"
                                Padding="0,12">
                      <RadioButtons x:Name="NotePage_BackdropRadioButtons"
                                    x:Uid="/NotePage/BackdropRadioButtons"
                                    SelectedIndex="{x:Bind Note.BackdropKind, Mode=TwoWay, Converter={StaticResource BackdropKindToIntConverter}}"
                                    MaxColumns="3">
                        <RadioButton x:Uid="/NotePage/BackdropNoneRadioButton"
                                     MinWidth="100" />
                        <RadioButton x:Uid="/NotePage/BackdropAcrylicRadioButton"
                                     MinWidth="100" />
                        <RadioButton x:Uid="/NotePage/BackdropMicaRadioButton"
                                     MinWidth="100" />
                      </RadioButtons>

                      <NavigationViewItemSeparator />

                      <ContentControl HorizontalContentAlignment="Stretch"
                                      IsEnabled="{x:Bind helpers:ObjectHelper.IsNotEqual(Note.BackdropKind, manm:BackdropKind.None), Mode=OneWay}">
                        <Grid RowSpacing="4"
                              ColumnSpacing="8">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <templates:TextContentControl x:Uid="/NotePage/BackdropTintOpacityHeaderTextBlock"
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="3" />

                          <templates:TextContentControl Grid.Row="1"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        Width="32"
                                                        Text="{x:Bind helpers:NumericHelper.Round(Note.BackdropTintOpacity, 2), Mode=OneWay}" />
                          <Slider Grid.Row="1"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Minimum="0"
                                  Maximum="1"
                                  StepFrequency="0.01"
                                  IsThumbToolTipEnabled="False"
                                  Value="{x:Bind Note.BackdropTintOpacity, Mode=TwoWay}" />
                          <templates:SubtleIconButton Grid.Row="1"
                                                      Grid.Column="2"
                                                      Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                      Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                      Command="{x:Bind EditorViewModel.ChangeBackdropTintOpacityToDefaultCommand}" />
                        </Grid>
                      </ContentControl>

                      <ContentControl HorizontalContentAlignment="Stretch"
                                      IsEnabled="{x:Bind helpers:ObjectHelper.IsNotEqual(Note.BackdropKind, manm:BackdropKind.None), Mode=OneWay}">
                        <Grid RowSpacing="4"
                              ColumnSpacing="8">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <templates:TextContentControl x:Uid="/NotePage/BackdropLuminosityOpacityHeaderTextBlock"
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="3" />

                          <templates:TextContentControl Grid.Row="1"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        Width="32"
                                                        Text="{x:Bind helpers:NumericHelper.Round(Note.BackdropLuminosityOpacity, 2), Mode=OneWay}" />
                          <Slider Grid.Row="1"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Minimum="0"
                                  Maximum="1"
                                  StepFrequency="0.01"
                                  IsThumbToolTipEnabled="False"
                                  Value="{x:Bind Note.BackdropLuminosityOpacity, Mode=TwoWay}" />

                          <templates:SubtleIconButton Grid.Row="1"
                                                      Grid.Column="2"
                                                      Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                      Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                      Command="{x:Bind EditorViewModel.ChangeBackdropLuminosityOpacityToDefaultCommand}" />
                        </Grid>
                      </ContentControl>
                    </StackPanel>
                  </ctwc:Case>

                  <!-- Background Image -->
                  <ctwc:Case>
                    <ctwc:Case.Value>
                      <x:Int32>2</x:Int32>
                    </ctwc:Case.Value>
                    <StackPanel Spacing="12">
                      <ToggleButton x:Name="NotePage_ShowBackdroundImageToggleButton"
                                    x:Uid="/NotePage/ShowBackdroundImageToggleButton"
                                    IsChecked="{x:Bind Note.ShowBackgroundImage, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,12,0,0" />

                      <ContentControl IsEnabled="{x:Bind Note.ShowBackgroundImage, Mode=OneWay}">
                        <StackPanel Spacing="12">
                          <RadioButtons x:Uid="/NotePage/BackgroundImageStretchRadioButtons"
                                        MaxColumns="4"
                                        SelectedIndex="{x:Bind Note.BackgroundImageStretch, Mode=TwoWay, Converter={StaticResource StretchToIntConverter}}">
                            <RadioButton x:Uid="/NotePage/BackgroundImageStretchNoneRadioButton"
                                         MinWidth="160" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageStretchFillRadioButton"
                                         MinWidth="160" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageStretchUniformRadioButton"
                                         MinWidth="160" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageStretchUniformToFillRadioButton"
                                         MinWidth="160" />
                          </RadioButtons>

                          <NavigationViewItemSeparator />

                          <RadioButtons x:Uid="/NotePage/BackgroundImageAlignmentXRadioButtons"
                                        SelectedIndex="{x:Bind EditorViewModel.BackgroundImageAlignmentX, Mode=TwoWay, Converter={StaticResource AlignmentXToIntConverter}}"
                                        MaxColumns="3">
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentXLeftRadioButton"
                                         MinWidth="100" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentXCenterRadioButton"
                                         MinWidth="100" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentXRightRadioButton"
                                         MinWidth="100" />
                          </RadioButtons>

                          <RadioButtons x:Uid="/NotePage/BackgroundImageAlignmentYRadioButtons"
                                        SelectedIndex="{x:Bind EditorViewModel.BackgroundImageAlignmentY, Mode=TwoWay, Converter={StaticResource AlignmentYToIntConverter}}"
                                        MaxColumns="3">
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentYTopRadioButton"
                                         MinWidth="100" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentYCenterRadioButton"
                                         MinWidth="100" />
                            <RadioButton x:Uid="/NotePage/BackgroundImageAlignmentYBottomRadioButton"
                                         MinWidth="100" />
                          </RadioButtons>

                          <NavigationViewItemSeparator />

                          <Grid RowSpacing="4"
                                ColumnSpacing="8">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <templates:TextContentControl x:Uid="/NotePage/BackgroundImageOpacityTextBlock"
                                                          Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.ColumnSpan="3" />

                            <templates:TextContentControl Grid.Row="1"
                                                          Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          HorizontalContentAlignment="Center"
                                                          Width="32"
                                                          Text="{x:Bind helpers:NumericHelper.GetPercentage(Note.BackgroundImageOpacity, 1.0), Mode=OneWay}" />
                            <Slider Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.01"
                                    IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Note.BackgroundImageOpacity, Mode=TwoWay}" />
                            <templates:SubtleIconButton Grid.Row="1"
                                                        Grid.Column="2"
                                                        Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                        Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                        Command="{x:Bind EditorViewModel.ChangeBackgroundImageOpacityToDefaultCommand}" />
                          </Grid>

                          <Grid RowSpacing="4"
                                ColumnSpacing="8">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <templates:TextContentControl x:Uid="/NotePage/BackgroundImageBlurTextBlock"
                                                          Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.ColumnSpan="3" />

                            <templates:TextContentControl Grid.Row="1"
                                                          Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          HorizontalContentAlignment="Center"
                                                          Width="32"
                                                          Text="{x:Bind helpers:NumericHelper.Round(Note.BackgroundImageBlur, 2), Mode=OneWay}" />
                            <Slider Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="100"
                                    IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Note.BackgroundImageBlur, Mode=TwoWay}" />
                            <templates:SubtleIconButton Grid.Row="1"
                                                        Grid.Column="2"
                                                        Content="{ctw:FontIcon Glyph=&#xE72C;}"
                                                        Style="{StaticResource SubtleIconButtonStyle_32x16}"
                                                        Command="{x:Bind EditorViewModel.ChangeBackgroundImageBlurToDefaultCommand}" />
                          </Grid>

                          <NavigationViewItemSeparator />

                          <Grid RowSpacing="4"
                                ColumnSpacing="8">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <templates:TextContentControl x:Uid="/NotePage/BackgroundImageSelectionTextBlock"
                                                          Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.ColumnSpan="2" />
                            <templates:TextContentControl Grid.Row="1"
                                                          Grid.Column="0"
                                                          Text="{x:Bind helpers:StringHelper.GetFileName(Note.BackgroundImagePath), Mode=OneWay}"
                                                          TextTrimming="CharacterEllipsis"
                                                          VerticalAlignment="Center"
                                                          IsTextSelectionEnabled="True"
                                                          ToolTipService.ToolTip="{x:Bind Note.BackgroundImagePath, Mode=OneWay}" />
                            <Button x:Uid="/NotePage/BackgroundImageBrowseButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind EditorViewModel.BrowseBackgroundImageCommand}" />
                          </Grid>
                        </StackPanel>
                      </ContentControl>
                    </StackPanel>
                  </ctwc:Case>
                </ctwc:SwitchPresenter>
              </StackPanel>
            </Flyout>
          </templates:SubtleIconButton.Flyout>
        </templates:SubtleIconButton>

        <Rectangle Width="1"
                   Stretch="Fill"
                   Margin="0,6"
                   Fill="{ThemeResource DividerStrokeColorDefault}" />

        <!-- Insert Image -->
        <templates:SubtleIconButton x:Name="NotePage_InsertImagesButton"
                                    x:Uid="/NotePage/InsertImagesButton"
                                    Content="{ctw:FontIcon Glyph=&#xE91B;}"
                                    Command="{x:Bind ImageCollectionViewModel.InsertImageCommand}"
                                    CommandParameter="{x:Bind XamlRoot.ContentIslandEnvironment.AppWindowId}" />
      </StackPanel>
    </ScrollViewer>
    <!--#endregion -->

    <!--#region InfoBar -->
    <InfoBar x:Name="NotePage_InfoBar"
             Grid.Row="2"
             IsOpen="False"
             Background="{ThemeResource ControlFillColorDefaultBrush}"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             Margin="12,4" />
    <!--#endregion -->

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="FlyoutThemeStates">
        <VisualState x:Name="FlyoutThemeDefault" />
        <VisualState x:Name="FlyoutThemeLight">
          <VisualState.Setters>
            <Setter Target="NotePage_BulletsAndNumberingButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FontSizeButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FontColorButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_HighlightColorButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_BackgroundButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource LightThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                    Value="{StaticResource LightThemeMenuFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FindReplaceBox.RequestedTheme"
                    Value="Light" />
            <Setter Target="NotePage_InfoBar.RequestedTheme"
                    Value="Light" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="FlyoutThemeDark">
          <VisualState.Setters>
            <Setter Target="NotePage_BulletsAndNumberingButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FontSizeButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FontColorButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_HighlightColorButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_BackgroundButtonFlyout.FlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeFlyoutPresenterStyle}" />
            <Setter Target="NotePage_MoreButtonMenuFlyout.MenuFlyoutPresenterStyle"
                    Value="{StaticResource DarkThemeMenuFlyoutPresenterStyle}" />
            <Setter Target="NotePage_FindReplaceBox.RequestedTheme"
                    Value="Dark" />
            <Setter Target="NotePage_InfoBar.RequestedTheme"
                    Value="Dark" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>

