<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MyNotes.Views.Media.ImageViewerPage"
      x:Name="ImageViewerPage_Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:templates="using:MyNotes.Templates"
      xmlns:ctw="using:CommunityToolkit.WinUI"
      xmlns:helpers="using:MyNotes.Common.Helpers">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="ImageViewerPage_TitleBar"
              Grid.Row="0">
      <TitleBar.Resources>
        <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
      </TitleBar.Resources>
      <TitleBar.LeftHeader>
        <StackPanel Orientation="Horizontal"
                    Padding="4,0"
                    Spacing="3">
          <templates:SubtleIconToggleButton x:Uid="/ImageViewerPage/PinWindowToggleButton"
                                            Grid.Column="0"
                                            Content="{ctw:FontIcon Glyph=&#xE718;}"
                                            IsChecked="{x:Bind IsAlwaysOnTop, Mode=TwoWay}">
            <templates:SubtleIconToggleButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                                   Key="P" />
            </templates:SubtleIconToggleButton.KeyboardAccelerators>
          </templates:SubtleIconToggleButton>
          <Rectangle Width="1"
                     Stretch="Fill"
                     Margin="0,6"
                     Fill="{ThemeResource DividerStrokeColorDefault}" />
          <templates:SubtleIconToggleButton x:Name="ImageViewerPage_ShowFilmstripToggleButton"
                                            x:Uid="/ImageViewerPage/ShowFilmstripToggleButton"
                                            Content="{ctw:FontIcon Glyph=&#xF597;}"
                                            IsChecked="{x:Bind IsFilmstripVisible, Mode=TwoWay}">
            <templates:SubtleIconToggleButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="F" />
            </templates:SubtleIconToggleButton.KeyboardAccelerators>
          </templates:SubtleIconToggleButton>
        </StackPanel>
      </TitleBar.LeftHeader>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal"
                    Padding="4,0"
                    Spacing="4">
          <templates:SubtleIconButton x:Uid="/ImageViewerPage/OpenWithButton"
                                      Content="{ctw:SymbolIcon Symbol=OpenWith}">
            <templates:SubtleIconButton.Flyout>
              <MenuFlyout Placement="Bottom">
                <MenuFlyoutItem x:Uid="/ImageViewerPage/OpenInFileExplorerMenuFlyoutItem"
                                Command="{x:Bind SelectedImage.OpenInFileExplorerCommand}" />
                <MenuFlyoutItem x:Uid="/ImageViewerPage/OpenInPhotosMenuFlyoutItem"
                                Command="{x:Bind SelectedImage.OpenInPhotosCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="/ImageViewerPage/SelectAppMenuFlyoutItem"
                                Icon="Add"
                                Command="{x:Bind SelectedImage.OpenWithCommand, Mode=OneWay}" />
              </MenuFlyout>
            </templates:SubtleIconButton.Flyout>
            <templates:SubtleIconButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                                   Key="O" />
            </templates:SubtleIconButton.KeyboardAccelerators>
          </templates:SubtleIconButton>
          <templates:SubtleIconButton x:Uid="/ImageViewerPage/SaveButton"
                                      Content="{ctw:SymbolIcon Symbol=Save}"
                                      Command="{x:Bind SelectedImage.SaveImageCommand, Mode=OneWay}"
                                      CommandParameter="{x:Bind ImageViewerPage_Root.XamlRoot.ContentIslandEnvironment.AppWindowId}">
            <templates:SubtleIconButton.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                                   Key="S" />
            </templates:SubtleIconButton.KeyboardAccelerators>
          </templates:SubtleIconButton>
          <Rectangle Width="1"
                     Stretch="Fill"
                     Margin="0,6"
                     Fill="{ThemeResource DividerStrokeColorDefault}" />
          <templates:SubtleIconButton x:Uid="/ImageViewerPage/DeleteButton"
                                      Content="{ctw:SymbolIcon Symbol=Delete}"
                                      Command="{x:Bind SelectedImage.DeleteImageCommand, Mode=OneWay}"
                                      CommandParameter="{x:Bind XamlRoot}">
            <templates:SubtleIconButton.KeyboardAccelerators>
              <KeyboardAccelerator Key="Delete" />
            </templates:SubtleIconButton.KeyboardAccelerators>
          </templates:SubtleIconButton>
        </StackPanel>
      </TitleBar.RightHeader>
    </TitleBar>

    <FlipView x:Name="ImageViewerPage_FlipView"
              Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind SelectedImage, Mode=TwoWay}"
              Background="Transparent"
              CornerRadius="0"
              Style="{StaticResource ImageViewerFlipViewStyle}">
      <FlipView.ItemContainerStyle>
        <Style TargetType="FlipViewItem"
               BasedOn="{StaticResource DefaultFlipViewItemStyle}">
          <Setter Property="HorizontalAlignment"
                  Value="Center" />
          <Setter Property="VerticalAlignment"
                  Value="Center" />
          <Setter Property="VerticalContentAlignment"
                  Value="Stretch" />
          <Setter Property="HorizontalContentAlignment"
                  Value="Stretch" />
        </Style>
      </FlipView.ItemContainerStyle>
      <FlipView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <mvm:ImageViewItemContainer ViewModel="{x:Bind Mode=OneWay}" />
        </DataTemplate>
      </FlipView.ItemTemplate>
    </FlipView>

    <TextBlock Grid.Row="1"
               Text="No image"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(ViewModel.HasImages), Mode=OneWay}"
               Style="{StaticResource HeaderTextBlockStyle}" />

    <PipsPager Grid.Row="2"
               HorizontalAlignment="Center"
               Margin="4"
               NumberOfPages="{x:Bind ViewModel.ImageCount, Mode=OneWay}"
               SelectedPageIndex="{x:Bind ImageViewerPage_FlipView.SelectedIndex, Mode=TwoWay}"
               PreviousButtonVisibility="VisibleOnPointerOver"
               NextButtonVisibility="VisibleOnPointerOver"
               Visibility="{x:Bind helpers:BooleanHelper.ToInverseVisibility(IsFilmstripVisible), Mode=OneWay}" />

    <GridView x:Name="ImageViewerPage_FlimstripGridView"
              Grid.Row="2"
              x:Load="{x:Bind IsFilmstripVisible, Mode=OneWay}"
              ItemsSource="{x:Bind ViewModel.ImageViewModels}"
              SelectedItem="{x:Bind SelectedImage, Mode=TwoWay}"
              SelectionMode="Single"
              BorderBrush="{ThemeResource DividerStrokeColorDefault}"
              BorderThickness="1"
              Height="100"
              Padding="8"
              ScrollViewer.HorizontalScrollMode="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Visible"
              ScrollViewer.VerticalScrollMode="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel Orientation="Horizontal"
                           HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="mvmm:ImageViewModel"
                      xmlns:mvm="using:MyNotes.Views.Media"
                      xmlns:mvmm="using:MyNotes.ViewModels.Media">
          <Border Background="{ThemeResource ControlAltFillColorQuarternary}"
                  Width="100"
                  Height="80">
            <mvm:ImageThumbnailItemContainer ViewModel="{x:Bind}"
                                             DecodePixelWidth="96"
                                             VerticalAlignment="Center"
                                             IsEnabled="False" />
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
